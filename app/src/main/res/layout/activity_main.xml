<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    android:background="@color/dark_gray">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Sony ANC Auto-Switch"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/on_surface"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="v1.2"
            android:textSize="12sp"
            android:textColor="#FF888888"
            android:layout_marginBottom="20dp" />

        <!-- ===== Headphone Info Card ===== -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/surface"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="16dp">

                <!-- Headphone icon -->
                <ImageView
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:src="@drawable/ic_headphones_big"
                    android:layout_gravity="center_vertical"
                    android:contentDescription="Headphones" />

                <!-- Info column -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginStart="16dp"
                    android:layout_gravity="center_vertical">

                    <!-- Model name -->
                    <TextView
                        android:id="@+id/textModel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="@color/on_surface"
                        android:text="WH-1000XM6" />

                    <!-- Status -->
                    <TextView
                        android:id="@+id/textStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="13sp"
                        android:textColor="#FFAAAAAA"
                        android:text="—"
                        android:paddingTop="2dp" />

                    <!-- Battery + Mode row -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingTop="6dp"
                        android:gravity="center_vertical">

                        <TextView
                            android:id="@+id/textBattery"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="14sp"
                            android:textColor="#FFAAAAAA"
                            android:text="🔋 —" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="14sp"
                            android:textColor="#FF666666"
                            android:text=" | "
                            android:paddingHorizontal="8dp" />

                        <TextView
                            android:id="@+id/textMode"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="14sp"
                            android:textColor="#FFAAAAAA"
                            android:text="🎧 —" />
                    </LinearLayout>

                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ===== Main Toggle Button ===== -->
        <Button
            android:id="@+id/btnToggle"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Start Service"
            android:textColor="@android:color/white"
            android:textSize="16sp"
            android:enabled="false"
            android:layout_marginBottom="16dp" />

        <!-- ===== Settings ===== -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="12dp"
            android:background="@color/surface"
            android:textColor="#FFBBBBBB"
            android:textSize="13sp"
            android:lineSpacingExtra="2dp"
            android:layout_marginBottom="12dp"
            android:text="@string/settings_text" />

        <!-- Device row (compact) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingVertical="6dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Device:"
                android:textSize="14sp"
                android:textColor="@color/on_surface"
                android:layout_marginEnd="12dp" />

            <Spinner
                android:id="@+id/spinnerDevice"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="40dp"
                android:background="@color/surface"
                android:textColor="@color/on_surface" />

            <Button
                android:id="@+id/btnRefresh"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:text="↻"
                android:textSize="18sp"
                android:textColor="@android:color/white"
                android:backgroundTint="#FF555555"
                android:padding="0dp"
                android:layout_marginStart="8dp" />
        </LinearLayout>

        <!-- Ambient level -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ambient level:"
            android:textSize="14sp"
            android:textColor="@color/on_surface"
            android:paddingTop="12dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/textLevelValue"
                android:layout_width="48dp"
                android:layout_height="wrap_content"
                android:text="20"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/on_surface" />

            <SeekBar
                android:id="@+id/seekLevel"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:max="19"
                android:progress="19" />
        </LinearLayout>

        <!-- Voice passthrough -->
        <Switch
            android:id="@+id/switchVoice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Focus on voice (voice passthrough)"
            android:textColor="@color/on_surface"
            android:paddingVertical="4dp" />

        <!-- Auto ambient (NEW) -->
        <Switch
            android:id="@+id/switchAutoAmbient"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Auto ambient (noise adaptive)"
            android:textColor="@color/on_surface"
            android:paddingVertical="4dp" />

        <!-- App allowlist -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Trigger apps:"
            android:textSize="14sp"
            android:textColor="@color/on_surface"
            android:paddingTop="12dp" />

        <Switch
            android:id="@+id/switchAllowlist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Only trigger for selected apps"
            android:textColor="@color/on_surface" />

        <Button
            android:id="@+id/btnChooseApps"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:text="Choose apps…"
            android:textColor="@android:color/white"
            android:backgroundTint="#FF445577"
            android:layout_marginTop="8dp" />

        <TextView
            android:id="@+id/textSelectedApps"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textColor="#FFAAAAAA"
            android:text=""
            android:layout_marginVertical="4dp" />

        <Button
            android:id="@+id/btnNotifAccess"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:text="Enable app detection (notification access)"
            android:textColor="@android:color/white"
            android:backgroundTint="#FF774444"
            android:layout_marginTop="4dp" />

        <!-- Info card -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="12dp"
            android:background="@color/surface"
            android:textColor="#FFBBBBBB"
            android:textSize="12sp"
            android:lineSpacingExtra="4dp"
            android:layout_marginTop="16dp"
            android:text="@string/info_text" />

        <!-- Version indicator -->
        <TextView
            android:id="@+id/textVersion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingTop="12dp"
            android:paddingBottom="8dp"
            android:textSize="11sp"
            android:textColor="#FF666666"
            android:text="v?" />

    </LinearLayout>

</ScrollView>