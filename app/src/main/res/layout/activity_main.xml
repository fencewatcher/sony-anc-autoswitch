<?xml version="1.0" encoding="utf-8"?>
<!--
  Layout rules for this screen:
  - one 16dp gutter, used by every tab, so the four panes line up;
  - every card is the same surface, 20dp radius, 1dp outline, no elevation;
  - section labels are 11sp/letter-spaced tertiary, not coloured headings;
  - controls are 48-52dp tall so a thumb can hit them.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/dark_gray">

    <!-- Tab bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:id="@+id/tabHome"
                android:layout_width="wrap_content"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Home"
                android:textSize="13sp"
                android:textStyle="bold" />

            <View
                android:id="@+id/underlineHome"
                android:layout_width="28dp"
                android:layout_height="2dp"
                android:layout_marginBottom="8dp"
                android:background="#00000000" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:id="@+id/tabAudio"
                android:layout_width="wrap_content"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Sound"
                android:textSize="13sp" />

            <View
                android:id="@+id/underlineAudio"
                android:layout_width="28dp"
                android:layout_height="2dp"
                android:layout_marginBottom="8dp"
                android:background="#00000000" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:id="@+id/tabDevices"
                android:layout_width="wrap_content"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Devices"
                android:textSize="13sp" />

            <View
                android:id="@+id/underlineDevices"
                android:layout_width="28dp"
                android:layout_height="2dp"
                android:layout_marginBottom="8dp"
                android:background="#00000000" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:id="@+id/tabRoutines"
                android:layout_width="wrap_content"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Routines"
                android:textSize="13sp" />

            <View
                android:id="@+id/underlineRoutines"
                android:layout_width="28dp"
                android:layout_height="2dp"
                android:layout_marginBottom="8dp"
                android:background="#00000000" />
        </LinearLayout>
    </LinearLayout>

    <!-- ================= HOME ================= -->
    <ScrollView
        android:id="@+id/homeContent"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="4dp"
            android:paddingBottom="24dp">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/surface"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/outline"
                app:strokeWidth="1dp"
                android:layout_marginBottom="12dp">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:padding="20dp">

                        <ImageView
                            android:id="@+id/imageModel"
                            android:layout_width="76dp"
                            android:layout_height="76dp"
                            android:layout_gravity="center_vertical"
                            android:contentDescription="Headphones"
                            android:scaleType="fitCenter"
                            android:src="@drawable/ic_headphones_big" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_vertical"
                            android:layout_marginStart="18dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <TextView
                                    android:id="@+id/textModel"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:ellipsize="end"
                                    android:singleLine="true"
                                    android:text="WH-1000XM6"
                                    android:textColor="@color/on_surface"
                                    android:textSize="20sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/textFeatureStatus"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="8dp"
                                    android:textColor="@color/accent"
                                    android:textSize="11sp"
                                    android:visibility="gone" />
                            </LinearLayout>

                            <TextView
                                android:id="@+id/textModelSub"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:paddingTop="2dp"
                                android:text="WH-1000XM6"
                                android:textColor="@color/text_tertiary"
                                android:textSize="11sp" />

                            <TextView
                                android:id="@+id/textStatus"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:paddingTop="4dp"
                                android:text="—"
                                android:textColor="@color/text_secondary"
                                android:textSize="13sp" />

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal"
                                android:paddingTop="12dp">

                                <TextView
                                    android:id="@+id/textMode"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="8dp"
                                    android:background="@drawable/bg_chip"
                                    android:paddingHorizontal="10dp"
                                    android:paddingVertical="5dp"
                                    android:text="—"
                                    android:textColor="@color/accent"
                                    android:textSize="12sp" />
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>

                    <ImageView
                        android:id="@+id/imageWear"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="bottom|end"
                        android:layout_margin="12dp"
                        android:contentDescription="Wearing status"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_headphones"
                        android:visibility="gone" />
                </FrameLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardBattery"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardBackgroundColor="@color/surface"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/outline"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        style="@style/SectionLabel"
                        android:text="BATTERY" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/textBattery"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="—"
                            android:textColor="@color/on_surface"
                            android:textSize="28sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/textBatteryEstimate"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="end"
                            android:text="--"
                            android:textColor="@color/text_secondary"
                            android:textSize="14sp" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <Button
                android:id="@+id/btnToggle"
                style="@style/PrimaryButton"
                android:layout_width="match_parent"
                android:layout_marginBottom="12dp"
                android:enabled="false"
                android:text="Start"
                app:backgroundTint="@color/stop_button_tint" />

            <Button
                android:id="@+id/btnRetryNow"
                style="@style/TonalButton"
                android:layout_width="match_parent"
                android:layout_marginBottom="12dp"
                android:text="Retry now"
                android:visibility="gone" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardBackgroundColor="@color/surface"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/outline"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        style="@style/SectionLabel"
                        android:text="NOISE CONTROL" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center_horizontal"
                            android:orientation="vertical">

                            <ImageView
                                android:id="@+id/btnModeNC"
                                android:layout_width="64dp"
                                android:layout_height="64dp"
                                android:background="@drawable/bg_mode_circle"
                                android:contentDescription="Noise cancelling"
                                android:padding="18dp"
                                android:src="@drawable/ic_mode_nc" />

                            <TextView
                                android:id="@+id/labelModeNC"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:gravity="center"
                                android:paddingTop="8dp"
                                android:text="Noise cancelling"
                                android:textColor="@color/text_secondary"
                                android:textSize="11sp" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center_horizontal"
                            android:orientation="vertical">

                            <ImageView
                                android:id="@+id/btnModeAmbient"
                                android:layout_width="64dp"
                                android:layout_height="64dp"
                                android:background="@drawable/bg_mode_circle"
                                android:contentDescription="Ambient sound"
                                android:padding="18dp"
                                android:src="@drawable/ic_mode_ambient" />

                            <TextView
                                android:id="@+id/labelModeAmbient"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:gravity="center"
                                android:paddingTop="8dp"
                                android:text="Ambient sound"
                                android:textColor="@color/text_secondary"
                                android:textSize="11sp" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center_horizontal"
                            android:orientation="vertical">

                            <ImageView
                                android:id="@+id/btnModeOff"
                                android:layout_width="64dp"
                                android:layout_height="64dp"
                                android:background="@drawable/bg_mode_circle"
                                android:contentDescription="Off"
                                android:padding="18dp"
                                android:src="@drawable/ic_mode_off" />

                            <TextView
                                android:id="@+id/labelModeOff"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:gravity="center"
                                android:paddingTop="8dp"
                                android:text="Off"
                                android:textColor="@color/text_secondary"
                                android:textSize="11sp" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardAutoSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardBackgroundColor="@color/surface"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/outline"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="20dp"
                    android:paddingEnd="12dp"
                    android:paddingVertical="10dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/textAutoSwitch"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Automations"
                            android:textColor="@color/on_surface"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:paddingTop="2dp"
                            android:text="Rules run while the service is on"
                            android:textColor="@color/text_tertiary"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <Switch
                        android:id="@+id/switchAuto"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/textVersion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:paddingVertical="12dp"
                android:text="v?"
                android:textColor="@color/text_tertiary"
                android:textSize="11sp" />
        </LinearLayout>
    </ScrollView>

    <!-- ================= SOUND ================= -->
    <ScrollView
        android:id="@+id/audioContent"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="4dp"
            android:paddingBottom="24dp">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardBackgroundColor="@color/surface"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/outline"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        style="@style/SectionLabel"
                        android:text="EQUALIZER" />

                    <TextView
                        android:id="@+id/textEQStatus"
                        style="@style/BodyText"
                        android:paddingBottom="16dp"
                        android:text="Select a preset — applies immediately" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/btnEQOff"
                            style="@style/TonalButton"
                            android:layout_width="0dp"
                            android:layout_marginEnd="4dp"
                            android:layout_weight="1"
                            android:text="Off" />

                        <Button
                            android:id="@+id/btnEQHeavy"
                            style="@style/TonalButton"
                            android:layout_width="0dp"
                            android:layout_marginStart="4dp"
                            android:layout_weight="1"
                            android:text="Heavy" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/btnEQClear"
                            style="@style/TonalButton"
                            android:layout_width="0dp"
                            android:layout_marginEnd="4dp"
                            android:layout_weight="1"
                            android:text="Clear" />

                        <Button
                            android:id="@+id/btnEQHard"
                            style="@style/TonalButton"
                            android:layout_width="0dp"
                            android:layout_marginStart="4dp"
                            android:layout_weight="1"
                            android:text="Hard" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/btnEQSoft"
                            style="@style/TonalButton"
                            android:layout_width="0dp"
                            android:layout_marginEnd="4dp"
                            android:layout_weight="1"
                            android:text="Soft" />

                        <Button
                            android:id="@+id/btnEQCustom"
                            style="@style/TonalButton"
                            android:layout_width="0dp"
                            android:layout_marginStart="4dp"
                            android:layout_weight="1"
                            android:text="Custom" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/btnEQUser1"
                            style="@style/TonalButton"
                            android:layout_width="0dp"
                            android:layout_marginEnd="4dp"
                            android:layout_weight="1"
                            android:text="User 1" />

                        <Button
                            android:id="@+id/btnEQUser2"
                            style="@style/TonalButton"
                            android:layout_width="0dp"
                            android:layout_marginStart="4dp"
                            android:layout_weight="1"
                            android:text="User 2" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/eqBandSection"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:orientation="vertical">

                        <TextView
                            style="@style/SectionLabel"
                            android:text="BANDS" />

                        <com.fencewatcher.sonyanc.EQGraphView
                            android:id="@+id/eqGraph"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp" />

                        <Button
                            android:id="@+id/btnApplyCustomEQ"
                            style="@style/TonalButton"
                            android:layout_width="match_parent"
                            android:layout_marginTop="12dp"
                            android:text="Write to Custom"
                            android:textColor="@color/accent"
                            android:visibility="gone"
                            app:backgroundTint="@color/accent_dim" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardBackgroundColor="@color/surface"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/outline"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        style="@style/SectionLabel"
                        android:text="AMBIENT SOUND" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingBottom="4dp">

                        <TextView
                            android:id="@+id/textLevelValue"
                            android:layout_width="52dp"
                            android:layout_height="wrap_content"
                            android:text="20"
                            android:textColor="@color/on_surface"
                            android:textSize="20sp"
                            android:textStyle="bold" />

                        <SeekBar
                            android:id="@+id/seekLevel"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:max="19"
                            android:progress="19" />
                    </LinearLayout>

                    <Switch
                        android:id="@+id/switchVoice"
                        style="@style/SwitchRow"
                        android:text="Voice passthrough" />

                    <Switch
                        android:id="@+id/switchAutoAmbient"
                        style="@style/SwitchRow"
                        android:text="Auto ambient (noise adaptive)" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardBackgroundColor="@color/surface"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/outline"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        style="@style/SectionLabel"
                        android:text="HEADPHONE FEATURES" />

                    <Switch
                        android:id="@+id/switchSpeakToChat"
                        style="@style/SwitchRow"
                        android:text="Speak-to-chat" />

                    <Switch
                        android:id="@+id/switchPauseOff"
                        style="@style/SwitchRow"
                        android:text="Pause when taken off" />

                    <Switch
                        android:id="@+id/switchDsee"
                        style="@style/SwitchRow"
                        android:text="DSEE Extreme" />

                    <TextView
                        android:id="@+id/textUpscaling"
                        style="@style/BodyText"
                        android:paddingBottom="4dp"
                        android:textColor="@color/accent"
                        android:textSize="11sp"
                        android:visibility="gone" />

                    <Switch
                        android:id="@+id/switchBgm"
                        style="@style/SwitchRow"
                        android:text="Background music (BGM)" />

                    <Switch
                        android:id="@+id/switchUpmix"
                        style="@style/SwitchRow"
                        android:text="Upmix / Cinema" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardBackgroundColor="@color/surface"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/outline"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        style="@style/SectionLabel"
                        android:text="POWER &amp; VOICE" />

                    <TextView
                        style="@style/BodyText"
                        android:text="Auto power off" />

                    <Spinner
                        android:id="@+id/spinnerAutoPower"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="4dp"
                        android:background="@drawable/bg_field"
                        android:paddingHorizontal="12dp" />

                    <TextView
                        style="@style/BodyText"
                        android:paddingTop="16dp"
                        android:text="Voice guidance volume" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <SeekBar
                            android:id="@+id/seekVoiceGuidance"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1" />

                        <TextView
                            android:id="@+id/textVoiceGuidanceValue"
                            android:layout_width="64dp"
                            android:layout_height="wrap_content"
                            android:gravity="end"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
