<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    android:background="@color/dark_gray">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Sony ANC Auto-Switch"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/on_surface"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Automatically switches ANC mode when media plays/pauses"
            android:textSize="13sp"
            android:textColor="#FF888888"
            android:layout_marginBottom="24dp" />

        <!-- Device selection -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Paired WH-1000XM devices:"
            android:textSize="14sp"
            android:textColor="@color/on_surface"
            android:layout_marginBottom="4dp" />

        <Spinner
            android:id="@+id/spinnerDevice"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@color/surface"
            android:textColor="@color/on_surface"
            android:layout_marginBottom="16dp" />

        <!-- Device list (text fallback for visibility) -->
        <TextView
            android:id="@+id/textDeviceList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textColor="#FFAAAAAA"
            android:layout_marginBottom="16dp" />

        <!-- Action buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <Button
                android:id="@+id/btnToggle"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:text="Start Service"
                android:textColor="@android:color/white"
                android:textSize="16sp"
                android:enabled="false"
                android:layout_marginEnd="8dp" />

            <Button
                android:id="@+id/btnRefresh"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:text="↻"
                android:textSize="20sp"
                android:textColor="@android:color/white"
                android:backgroundTint="#FF555555" />
        </LinearLayout>

        <!-- Status -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="—"
            android:id="@+id/textStatus"
            android:textSize="16sp"
            android:textColor="@color/on_surface"
            android:padding="12dp"
            android:background="@color/surface"
            android:gravity="center"
            android:layout_marginBottom="16dp" />

        <!-- Settings card -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="12dp"
            android:background="@color/surface"
            android:textColor="#FFBBBBBB"
            android:textSize="13sp"
            android:lineSpacingExtra="2dp"
            android:text="@string/settings_text" />

        <!-- Ambient level -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ambient level:"
            android:textSize="14sp"
            android:textColor="@color/on_surface"
            android:paddingTop="16dp"
            android:layout_marginBottom="4dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="4dp">

            <TextView
                android:id="@+id/textLevelValue"
                android:layout_width="48dp"
                android:layout_height="wrap_content"
                android:text="20"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/on_surface" />

            <SeekBar
                android:id="@+id/seekLevel"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:max="19"
                android:progress="19" />
        </LinearLayout>

        <!-- Voice passthrough -->
        <Switch
            android:id="@+id/switchVoice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Focus on voice (voice passthrough)"
            android:textColor="@color/on_surface"
            android:layout_marginTop="8dp" />

        <!-- App allowlist -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Trigger apps:"
            android:textSize="14sp"
            android:textColor="@color/on_surface"
            android:paddingTop="16dp"
            android:layout_marginBottom="4dp" />

        <Switch
            android:id="@+id/switchAllowlist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Only trigger for selected apps"
            android:textColor="@color/on_surface" />

        <Button
            android:id="@+id/btnChooseApps"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Choose apps…"
            android:textColor="@android:color/white"
            android:backgroundTint="#FF445577"
            android:layout_marginTop="8dp" />

        <TextView
            android:id="@+id/textSelectedApps"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textColor="#FFAAAAAA"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btnNotifAccess"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Enable app detection (notification access)"
            android:textColor="@android:color/white"
            android:backgroundTint="#FF774444"
            android:layout_marginTop="8dp" />

        <!-- Info card -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="12dp"
            android:background="@color/surface"
            android:textColor="#FFBBBBBB"
            android:textSize="12sp"
            android:lineSpacingExtra="4dp"
            android:layout_marginTop="16dp"
            android:text="@string/info_text" />

        <!-- Version indicator -->
        <TextView
            android:id="@+id/textVersion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingTop="16dp"
            android:paddingBottom="8dp"
            android:textSize="11sp"
            android:textColor="#FF666666"
            android:text="v?" />

    </LinearLayout>

</ScrollView>