<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/dark_gray">

    <!-- ===== Tab Bar ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:gravity="center"
        android:background="@color/surface"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp">

        <TextView
            android:id="@+id/tabDashboard"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="Dashboard"
            android:textSize="15sp"
            android:textColor="@color/on_surface"
            android:paddingVertical="12dp" />

        <TextView
            android:id="@+id/tabSettings"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="Settings"
            android:textSize="15sp"
            android:textColor="#FF888888"
            android:paddingVertical="12dp" />
    </LinearLayout>

    <!-- ===== Scrollable content area ===== -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- ============ DASHBOARD TAB ============ -->
            <LinearLayout
                android:id="@+id/dashboardContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Headphone Info Card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="@color/surface"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="4dp"
                    android:layout_marginBottom="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:padding="16dp">

                        <ImageView
                            android:layout_width="72dp"
                            android:layout_height="72dp"
                            android:src="@drawable/ic_headphones_big"
                            android:layout_gravity="center_vertical"
                            android:contentDescription="Headphones" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_marginStart="16dp"
                            android:layout_gravity="center_vertical">

                            <TextView
                                android:id="@+id/textModel"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textSize="18sp"
                                android:textStyle="bold"
                                android:textColor="@color/on_surface"
                                android:text="WH-1000XM6" />

                            <TextView
                                android:id="@+id/textStatus"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textSize="13sp"
                                android:textColor="#FFAAAAAA"
                                android:text="—"
                                android:paddingTop="2dp" />

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:paddingTop="6dp"
                                android:gravity="center_vertical">

                                <TextView
                                    android:id="@+id/textBattery"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textSize="14sp"
                                    android:textColor="#FFAAAAAA"
                                    android:text="🔋 —" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textSize="14sp"
                                    android:textColor="#FF666666"
                                    android:text=" | "
                                    android:paddingHorizontal="8dp" />

                                <TextView
                                    android:id="@+id/textMode"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textSize="14sp"
                                    android:textColor="#FFAAAAAA"
                                    android:text="🎧 —" />
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Toggle button -->
                <Button
                    android:id="@+id/btnToggle"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:text="Start Service"
                    android:textColor="@android:color/white"
                    android:textSize="16sp"
                    android:enabled="false"
                    android:layout_marginBottom="12dp" />

                <!-- Quick mode buttons -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="16dp">

                    <Button
                        android:id="@+id/btnQuickNC"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="44dp"
                        android:text="🔇 NC"
                        android:textColor="@android:color/white"
                        android:backgroundTint="#FF446688"
                        android:layout_marginEnd="4dp" />

                    <Button
                        android:id="@+id/btnQuickAmbient"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="44dp"
                        android:text="🌬 Ambient"
                        android:textColor="@android:color/white"
                        android:backgroundTint="#FF448866"
                        android:layout_marginHorizontal="4dp" />

                    <Button
                        android:id="@+id/btnQuickOff"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="44dp"
                        android:text="⛔ Off"
                        android:textColor="@android:color/white"
                        android:backgroundTint="#FF884444"
                        android:layout_marginStart="4dp" />
                </LinearLayout>

            </LinearLayout>

            <!-- ============ SETTINGS TAB ============ -->
            <LinearLayout
                android:id="@+id/settingsContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <!-- Device -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Device"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/on_surface"
                    android:paddingBottom="8dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingVertical="6dp">

                    <Spinner
                        android:id="@+id/spinnerDevice"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="40dp"
                        android:background="@color/surface"
                        android:textColor="@color/on_surface" />

                    <Button
                        android:id="@+id/btnRefresh"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:text="↻"
                        android:textSize="18sp"
                        android:textColor="@android:color/white"
                        android:backgroundTint="#FF555555"
                        android:padding="0dp"
                        android:layout_marginStart="8dp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/textProfile"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="12sp"
                    android:textColor="#FF888888"
                    android:text="Protocol: auto-detect"
                    android:layout_marginBottom="12dp" />

                <!-- Ambient -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ambient level:"
                    android:textSize="14sp"
                    android:textColor="@color/on_surface"
                    android:paddingTop="8dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/textLevelValue"
                        android:layout_width="48dp"
                        android:layout_height="wrap_content"
                        android:text="20"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="@color/on_surface" />

                    <SeekBar
                        android:id="@+id/seekLevel"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:max="19"
                        android:progress="19" />
                </LinearLayout>

                <Switch
                    android:id="@+id/switchVoice"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Focus on voice (voice passthrough)"
                    android:textColor="@color/on_surface"
                    android:paddingVertical="4dp" />

                <Switch
                    android:id="@+id/switchAutoAmbient"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Auto ambient (noise adaptive)"
                    android:textColor="@color/on_surface"
                    android:paddingVertical="4dp" />

                <!-- App filter -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Trigger apps:"
                    android:textSize="14sp"
                    android:textColor="@color/on_surface"
                    android:paddingTop="12dp" />

                <Switch
                    android:id="@+id/switchAllowlist"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Only trigger for selected apps"
                    android:textColor="@color/on_surface" />

                <Button
                    android:id="@+id/btnChooseApps"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:text="Choose apps…"
                    android:textColor="@android:color/white"
                    android:backgroundTint="#FF445577"
                    android:layout_marginTop="8dp" />

                <TextView
                    android:id="@+id/textSelectedApps"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="12sp"
                    android:textColor="#FFAAAAAA"
                    android:text=""
                    android:layout_marginVertical="4dp" />

                <Button
                    android:id="@+id/btnNotifAccess"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:text="Enable app detection (notification access)"
                    android:textColor="@android:color/white"
                    android:backgroundTint="#FF774444"
                    android:layout_marginTop="4dp" />
            </LinearLayout>

            <!-- ===== Info + Version (always visible) ===== -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="12dp"
                android:background="@color/surface"
                android:textColor="#FFBBBBBB"
                android:textSize="12sp"
                android:lineSpacingExtra="4dp"
                android:layout_marginTop="16dp"
                android:text="@string/info_text" />

            <TextView
                android:id="@+id/textVersion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:paddingTop="12dp"
                android:paddingBottom="8dp"
                android:textSize="11sp"
                android:textColor="#FF666666"
                android:text="v?" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>