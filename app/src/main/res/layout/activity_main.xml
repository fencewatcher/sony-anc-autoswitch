<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/dark_gray">

    <!-- ===== Tab Bar (3 tabs) with underline indicator ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:gravity="center"
        android:background="@color/surface"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:id="@+id/tabDashboard"
                android:layout_width="wrap_content"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Dashboard"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/on_surface" />

            <View
                android:id="@+id/underlineDashboard"
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:background="#FF66BBFF" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:id="@+id/tabSettings"
                android:layout_width="wrap_content"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Settings"
                android:textSize="15sp"
                android:textColor="#FF888888" />

            <View
                android:id="@+id/underlineSettings"
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:background="#00000000" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:id="@+id/tabEQ"
                android:layout_width="wrap_content"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="EQ"
                android:textSize="15sp"
                android:textColor="#FF888888" />

            <View
                android:id="@+id/underlineEQ"
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:background="#00000000" />
        </LinearLayout>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- ============ DASHBOARD ============ -->
            <LinearLayout
                android:id="@+id/dashboardContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="@color/surface"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="4dp"
                    android:layout_marginBottom="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:padding="16dp">

                        <ImageView
                            android:layout_width="72dp"
                            android:layout_height="72dp"
                            android:src="@drawable/ic_headphones_big"
                            android:layout_gravity="center_vertical"
                            android:contentDescription="Headphones" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_marginStart="16dp"
                            android:layout_gravity="center_vertical">

                            <TextView
                                android:id="@+id/textModel"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textSize="18sp"
                                android:textStyle="bold"
                                android:textColor="@color/on_surface"
                                android:text="WH-1000XM6" />

                            <TextView
                                android:id="@+id/textStatus"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textSize="13sp"
                                android:textColor="#FFAAAAAA"
                                android:text="—"
                                android:paddingTop="2dp" />

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:paddingTop="6dp"
                                android:gravity="center_vertical">

                                <TextView
                                    android:id="@+id/textBattery"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textSize="14sp"
                                    android:textColor="#FFAAAAAA"
                                    android:text="🔋 —" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textSize="14sp"
                                    android:textColor="#FF666666"
                                    android:text=" | "
                                    android:paddingHorizontal="8dp" />

                                <TextView
                                    android:id="@+id/textMode"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textSize="14sp"
                                    android:textColor="#FFAAAAAA"
                                    android:text="🎧 —" />
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <Button
                    android:id="@+id/btnToggle"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:text="▶ Start"
                    android:textColor="@android:color/white"
                    android:textSize="15sp"
                    android:enabled="false"
                    android:paddingHorizontal="8dp"
                    android:layout_marginBottom="12dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="16dp">

                    <Button
                        android:id="@+id/btnQuickNC"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="44dp"
                        android:text="🔇 NC"
                        android:textColor="@android:color/white"
                        android:paddingHorizontal="8dp"
                        android:backgroundTint="#FF446688"
                        android:layout_marginEnd="4dp" />

                    <Button
                        android:id="@+id/btnQuickAmbient"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="44dp"
                        android:text="🌬 Ambient"
                        android:textColor="@android:color/white"
                        android:paddingHorizontal="8dp"
                        android:backgroundTint="#FF448866"
                        android:layout_marginHorizontal="4dp" />

                    <Button
                        android:id="@+id/btnQuickOff"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="44dp"
                        android:text="⛔ Off"
                        android:textColor="@android:color/white"
                        android:paddingHorizontal="8dp"
                        android:backgroundTint="#FF884444"
                        android:layout_marginStart="4dp" />
                </LinearLayout>

                <Button
                    android:id="@+id/btnPowerOff"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="⏹ Power Off"
                    android:textColor="@android:color/white"
                    android:paddingHorizontal="8dp"
                    android:backgroundTint="#FF662222"
                    android:layout_marginBottom="12dp" />

                <TextView
                    android:id="@+id/textVersion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:paddingVertical="8dp"
                    android:textSize="11sp"
                    android:textColor="#FF666666"
                    android:text="v?" />
            </LinearLayout>

            <!-- ============ SETTINGS ============ -->
            <LinearLayout
                android:id="@+id/settingsContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="DEVICE"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="#FF888888"
                    android:paddingBottom="8dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingVertical="6dp">

                    <Spinner
                        android:id="@+id/spinnerDevice"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="40dp"
                        android:background="@color/surface"
                        android:textColor="@color/on_surface" />

                    <Button
                        android:id="@+id/btnRefresh"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:text="↻"
                        android:textSize="18sp"
                        android:textColor="@android:color/white"
                        android:backgroundTint="#FF555555"
                        android:padding="0dp"
                        android:layout_marginStart="8dp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/textProfile"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="12sp"
                    android:textColor="#FF888888"
                    android:text="Protocol: auto-detect"
                    android:layout_marginBottom="20dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="AMBIENT"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="#FF888888"
                    android:paddingBottom="8dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/textLevelValue"
                        android:layout_width="48dp"
                        android:layout_height="wrap_content"
                        android:text="20"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="@color/on_surface" />

                    <SeekBar
                        android:id="@+id/seekLevel"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:max="19"
                        android:progress="19" />
                </LinearLayout>

                <Switch
                    android:id="@+id/switchVoice"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Voice passthrough"
                    android:textColor="@color/on_surface"
                    android:paddingVertical="4dp" />

                <Switch
                    android:id="@+id/switchAutoAmbient"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Auto ambient (noise adaptive)"
                    android:textColor="@color/on_surface"
                    android:paddingVertical="4dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="TRIGGER APPS"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="#FF888888"
                    android:paddingTop="16dp"
                    android:paddingBottom="8dp" />

                <Switch
                    android:id="@+id/switchAllowlist"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Only trigger for selected apps"
                    android:textColor="@color/on_surface" />

                <Button
                    android:id="@+id/btnChooseApps"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:text="Select apps…"
                    android:textColor="@android:color/white"
                    android:paddingHorizontal="8dp"
                    android:backgroundTint="#FF445577"
                    android:layout_marginTop="8dp" />

                <TextView
                    android:id="@+id/textSelectedApps"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="12sp"
                    android:textColor="#FFAAAAAA"
                    android:text=""
                    android:layout_marginVertical="4dp" />

                <Button
                    android:id="@+id/btnNotifAccess"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:text="Enable notification access"
                    android:textColor="@android:color/white"
                    android:paddingHorizontal="8dp"
                    android:backgroundTint="#FF774444"
                    android:layout_marginTop="4dp" />

                <!-- ============ MULTIPOINT ============ -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="MULTIPOINT"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="#FF888888"
                    android:paddingTop="20dp"
                    android:paddingBottom="8dp" />

                <LinearLayout
                    android:id="@+id/multiPointList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <TextView
                    android:id="@+id/textMultiPointStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="12sp"
                    android:textColor="#FFAAAAAA"
                    android:paddingTop="6dp"
                    android:text="Tap a device to switch audio source" />

                <Button
                    android:id="@+id/btnRefreshDevices"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:text="↻ Refresh devices"
                    android:textColor="@android:color/white"
                    android:paddingHorizontal="8dp"
                    android:backgroundTint="#FF445577"
                    android:layout_marginTop="6dp" />

                <!-- ============ HEADPHONE FEATURES ============ -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="HEADPHONE FEATURES"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="#FF888888"
                    android:paddingTop="20dp"
                    android:paddingBottom="4dp" />

                <Switch
                    android:id="@+id/switchSpeakToChat"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Speak-to-chat"
                    android:textColor="@color/on_surface" />

                <Switch
                    android:id="@+id/switchPauseOff"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Pause when taken off"
                    android:textColor="@color/on_surface" />

                <Switch
                    android:id="@+id/switchDsee"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="DSEE Extreme"
                    android:textColor="@color/on_surface" />

                <Switch
                    android:id="@+id/switchBgm"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Background music (BGM)"
                    android:textColor="@color/on_surface" />

                <Switch
                    android:id="@+id/switchUpmix"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Upmix / Cinema"
                    android:textColor="@color/on_surface" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="AUTO POWER OFF"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="#FF888888"
                    android:paddingTop="16dp"
                    android:paddingBottom="4dp" />

                <Spinner
                    android:id="@+id/spinnerAutoPower"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:background="@color/surface"
                    android:textColor="@color/on_surface" />

                <!-- ============ AUTOMATIONS ============ -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="AUTOMATIONS"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="#FF888888"
                    android:paddingTop="20dp"
                    android:paddingBottom="4dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Decide what the headphones do when things happen. First matching rule wins."
                    android:textSize="12sp"
                    android:textColor="#FFAAAAAA"
                    android:paddingBottom="6dp" />

                <LinearLayout
                    android:id="@+id/automationList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <Button
                    android:id="@+id/btnAddAutomation"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:text="+ Add rule"
                    android:textColor="@android:color/white"
                    android:paddingHorizontal="8dp"
                    android:backgroundTint="#FF448866"
                    android:layout_marginTop="8dp" />

                <Button
                    android:id="@+id/btnResetAutomation"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:text="Reset to defaults"
                    android:textColor="#FFAAAAAA"
                    android:paddingHorizontal="8dp"
                    android:backgroundTint="#FF333333"
                    android:layout_marginTop="4dp" />

                <!-- ============ VOLUME ============ -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="VOLUME"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="#FF888888"
                    android:paddingTop="20dp"
                    android:paddingBottom="4dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Media volume"
                    android:textSize="14sp"
                    android:textColor="@color/on_surface" />

                <SeekBar
                    android:id="@+id/seekMediaVolume"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="20" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Voice guidance volume"
                    android:textSize="14sp"
                    android:textColor="@color/on_surface"
                    android:paddingTop="8dp" />

                <SeekBar
                    android:id="@+id/seekVoiceGuidance"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="15" />
            </LinearLayout>

            <!-- ============ EQ TAB ============ -->
            <LinearLayout
                android:id="@+id/eqContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PRESETS"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="#FF888888"
                    android:paddingBottom="12dp" />

                <TextView
                    android:id="@+id/textEQStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="13sp"
                    android:textColor="#FFAAAAAA"
                    android:text="Select a preset — applies immediately"
                    android:paddingBottom="16dp" />

                <!-- Preset buttons grid: 2 columns -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="8dp">

                    <Button
                        android:id="@+id/btnEQOff"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="48dp"
                        android:text="Off"
                        android:textColor="@android:color/white"
                        android:paddingHorizontal="8dp"
                        android:backgroundTint="#FF555555"
                        android:layout_marginEnd="4dp" />

                    <Button
                        android:id="@+id/btnEQHeavy"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="48dp"
                        android:text="Heavy"
                        android:textColor="@android:color/white"
                        android:paddingHorizontal="8dp"
                        android:backgroundTint="#FF555555"
                        android:layout_marginStart="4dp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="8dp">

                    <Button
                        android:id="@+id/btnEQClear"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="48dp"
                        android:text="Clear"
                        android:textColor="@android:color/white"
                        android:paddingHorizontal="8dp"
                        android:backgroundTint="#FF555555"
                        android:layout_marginEnd="4dp" />

                    <Button
                        android:id="@+id/btnEQHard"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="48dp"
                        android:text="Hard"
                        android:textColor="@android:color/white"
                        android:paddingHorizontal="8dp"
                        android:backgroundTint="#FF555555"
                        android:layout_marginStart="4dp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="8dp">

                    <Button
                        android:id="@+id/btnEQSoft"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="48dp"
                        android:text="Soft"
                        android:textColor="@android:color/white"
                        android:paddingHorizontal="8dp"
                        android:backgroundTint="#FF555555"
                        android:layout_marginEnd="4dp" />

                    <Button
                        android:id="@+id/btnEQCustom"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="48dp"
                        android:text="Custom"
                        android:textColor="@android:color/white"
                        android:paddingHorizontal="8dp"
                        android:backgroundTint="#FF555555"
                        android:layout_marginStart="4dp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnEQUser1"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="48dp"
                        android:text="User 1"
                        android:textColor="@android:color/white"
                        android:paddingHorizontal="8dp"
                        android:backgroundTint="#FF555555"
                        android:layout_marginEnd="4dp" />

                    <Button
                        android:id="@+id/btnEQUser2"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="48dp"
                        android:text="User 2"
                        android:textColor="@android:color/white"
                        android:paddingHorizontal="8dp"
                        android:backgroundTint="#FF555555"
                        android:layout_marginStart="4dp" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:paddingTop="16dp"
                    android:textSize="11sp"
                    android:textColor="#FF666666"
                    android:text="Service must be running to apply EQ" />

                <!-- Custom EQ bands (always visible — disabled for built-in presets) -->
                <LinearLayout
                    android:id="@+id/eqBandSection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingTop="20dp"
                    android:paddingBottom="8dp"
                    android:background="@color/surface"
                    android:padding="12dp"
                    android:layout_marginTop="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="BANDS"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="#FF888888"
                        android:paddingBottom="8dp" />

                    <com.fencewatcher.sonyanc.EQGraphView
                        android:id="@+id/eqGraph"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp" />

                    <Button
                        android:id="@+id/btnApplyCustomEQ"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:text="Write to Custom"
                        android:textColor="@android:color/white"
                        android:paddingHorizontal="8dp"
                        android:backgroundTint="#CC8833"
                        android:layout_marginTop="12dp"
                        android:visibility="gone" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>