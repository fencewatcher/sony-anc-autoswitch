        android:fillColor="#FFFFFFFF"
        android:pathData="M12,8a4,4 0 1 1 0,8 4,4 0 1 1 0,-8z" />

    <path
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="1.7"
        android:strokeLineCap="round"
        android:pathData="M12,1.8 V4.4 M12,19.6 V22.2 M1.8,12 H4.4 M19.6,12 H22.2
                          M4.8,4.8 L6.6,6.6 M17.4,17.4 L19.2,19.2
