<?xml version="1.0" encoding="utf-8"?>
<!--
  Two previous attempts rendered as a horseshoe/magnet: one used the Material
  "headset" glyph (an open C-arc with a notch), the next hand-wrote a single
  filled silhouette whose ear cups were tall enough to read as the poles of a
  magnet rather than as earcups.

  This is built from parts instead of one blob, so each element stays legible:
  a stroked headband arc, and two separate rounded ear cups. When a real
  product photo lands in drawable-nodpi/ this stays as the fallback for
  unrecognised models.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="72dp"
    android:height="72dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <!-- headband: half-circle arc with short legs down to the ear cups -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FFD8D8D8"
        android:strokeWidth="2.1"
        android:pathData="M4,15 v-3 a8,8 0 0 1 16,0 v3" />

    <!-- left ear cup -->
    <path
        android:fillColor="#FFD8D8D8"
        android:pathData="M2.6,13.6 h3.6 v6.6 a1.8,1.8 0 0 1 -1.8,1.8 a1.8,1.8 0 0 1 -1.8,-1.8 z" />

    <!-- right ear cup -->
    <path
        android:fillColor="#FFD8D8D8"
        android:pathData="M17.8,13.6 h3.6 v6.6 a1.8,1.8 0 0 1 -1.8,1.8 a1.8,1.8 0 0 1 -1.8,-1.8 z" />
</vector>
