<!--
  In-app hero icon.

  The headband legs were at x 4 and 20 while the ear cups centre on 4.4 and
  19.6, so the band sat 0.4 outboard of the cups it connects. Legs are now at
  4.4/19.6 with a 7.6 radius semicircle, which is exactly the gap between them.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="72dp"
    android:height="72dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <!-- headband -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FFD8D8D8"
        android:strokeWidth="2.1"
        android:pathData="M4.4,15 v-3 a7.6,7.6 0 0 1 15.2,0 v3" />

    <!-- left ear cup -->
    <path
        android:fillColor="#FFD8D8D8"
        android:pathData="M2.6,13.6 h3.6 v6.6 a1.8,1.8 0 0 1 -1.8,1.8 a1.8,1.8 0 0 1 -1.8,-1.8 z" />

    <!-- right ear cup -->
    <path
        android:fillColor="#FFD8D8D8"
        android:pathData="M17.8,13.6 h3.6 v6.6 a1.8,1.8 0 0 1 -1.8,1.8 a1.8,1.8 0 0 1 -1.8,-1.8 z" />
