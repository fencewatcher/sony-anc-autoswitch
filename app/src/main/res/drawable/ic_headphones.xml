<?xml version="1.0" encoding="utf-8"?>
<!--
  Launcher icon. Same geometry as the in-app icon: headband legs at 4.4/19.6
  with a 7.6 radius semicircle so the band lines up with the ear cups.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="48dp"
    android:height="48dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <!-- headband -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="2.2"
        android:pathData="M4.4,15 v-3 a7.6,7.6 0 0 1 15.2,0 v3" />

    <!-- left ear cup -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M2.6,13.6 h3.6 v6.6 a1.8,1.8 0 0 1 -1.8,1.8 a1.8,1.8 0 0 1 -1.8,-1.8 z" />

    <!-- right ear cup -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M17.8,13.6 h3.6 v6.6 a1.8,1.8 0 0 1 -1.8,1.8 a1.8,1.8 0 0 1 -1.8,-1.8 z" />
</vector>
