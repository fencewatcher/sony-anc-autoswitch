<?xml version="1.0" encoding="utf-8"?>
<!--
  Was the same Material "headset" glyph as the in-app icon: an open C-arc with a
  notch, which reads as a horseshoe rather than headphones. Rebuilt from parts
  (stroked headband arc + two separate ear cups) so each element stays legible.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="48dp"
    android:height="48dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <!-- headband -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="2.2"
        android:pathData="M4,15 v-3 a8,8 0 0 1 16,0 v3" />

    <!-- left ear cup -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M2.6,13.6 h3.6 v6.6 a1.8,1.8 0 0 1 -1.8,1.8 a1.8,1.8 0 0 1 -1.8,-1.8 z" />

    <!-- right ear cup -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M17.8,13.6 h3.6 v6.6 a1.8,1.8 0 0 1 -1.8,1.8 a1.8,1.8 0 0 1 -1.8,-1.8 z" />
</vector>
