<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.SonyAncAutoSwitch" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <!-- The accent is the checked-state colour for switches, the seek bar
             and the tab underline, so it belongs on both primary and secondary. -->
        <item name="colorPrimary">@color/accent</item>
        <item name="colorPrimaryVariant">@color/accent_dim</item>
        <item name="colorOnPrimary">@color/dark_gray</item>
        <item name="colorSecondary">@color/accent</item>
        <item name="colorSecondaryVariant">@color/accent_dim</item>
        <item name="colorOnSecondary">@color/dark_gray</item>

        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/on_surface</item>
        <item name="android:colorBackground">@color/dark_gray</item>
        <item name="android:windowBackground">@color/dark_gray</item>
        <item name="android:statusBarColor">@color/dark_gray</item>
        <item name="android:navigationBarColor">@color/dark_gray</item>
        <item name="android:textColorPrimary">@color/on_surface</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>

        <item name="actionBarStyle">@style/AppActionBar</item>
    </style>

    <!-- colorPrimary is now the accent, and DarkActionBar paints the bar with it.
         Without this the title bar would turn mint. -->
    <style name="AppActionBar" parent="Widget.MaterialComponents.ActionBar.Solid">
        <item name="background">@color/dark_gray</item>
        <item name="titleTextStyle">@style/AppActionBar.Title</item>
    </style>

    <style name="AppActionBar.Title" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:textColor">@color/on_surface</item>
        <item name="android:textSize">18sp</item>
    </style>

    <!-- Reusable text roles. Keeps the XML readable and the spacing honest. -->
    <style name="SectionLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.12</item>
        <item name="android:textColor">@color/text_tertiary</item>
        <item name="android:paddingBottom">12dp</item>
    </style>

    <style name="CardTitle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/on_surface</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="BodyText">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <!-- Tonal button: a raised surface with accent text, not a slab of grey. -->
    <style name="TonalButton" parent="Widget.MaterialComponents.Button">
        <item name="android:layout_height">48dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/on_surface</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:paddingHorizontal">12dp</item>
        <item name="backgroundTint">@color/surface_raised</item>
        <item name="cornerRadius">14dp</item>
        <item name="rippleColor">@color/accent_dim</item>
    </style>

    <style name="PrimaryButton" parent="Widget.MaterialComponents.Button">
        <item name="android:layout_height">50dp</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/dark_gray</item>
        <item name="android:textAllCaps">false</item>
        <item name="backgroundTint">@color/accent</item>
        <item name="cornerRadius">16dp</item>
    </style>

    <style name="SwitchRow" parent="Widget.MaterialComponents.CompoundButton.Switch">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/on_surface</item>
    </style>
</resources>
